# Copy to .env and fill in real values. NEVER commit .env.
# SQLite (local dev). For production prefer a managed Postgres.
DATABASE_URL="file:./prisma/dev.db"

# REQUIRED in production (>= 32 bytes of random data).
# Generate with: openssl rand -base64 48
JWT_SECRET=""

# Optional: key used to encrypt provider keys / channel credentials at rest.
# Falls back to JWT_SECRET when unset.
SECRETS_ENCRYPTION_KEY=""

# Public base URL of the platform (used for webhook URLs / links)
NEXT_PUBLIC_BASE_URL="https://botler.help"
